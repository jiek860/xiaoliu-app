        },
        "温和": {
          "text": "语气温和，先共情再给建议；不用命令句，不说教。",
          "emoji_budget": 2
        },
        "专业": {
          "text": "语气克制、信息密度高；先结论后依据，少用语气词和 emoji。",
          "emoji_budget": 0
