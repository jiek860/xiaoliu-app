# ============================================================
#  小6智能体 · 环境变量示例
#
#  用法：把本文件复制成 .env 填上自己的值（.env 已在 .gitignore 里）。
#  注意：本项目【没有】自动加载 .env 的代码，有两种用法：
#    A. 直接在系统里设环境变量（推荐，见下）
#         setx X6_KEY_VAULT "E:\xiao6-keys"      :: 设完要重开命令行
#    B. 用启动脚本临时设：在 启动PyQt.bat 开头加 set 行
#
#  程序配置（模型、人格、超时等 40 多项）不在环境变量里，
#  在 data/config.json；可参考 config.default.json（脱敏模板）。
# ============================================================


# ---------- 密钥库（只有开发者需要）----------
# 私钥所在目录。程序端只需要公钥，不要把这个目录放进程序目录或发布包。
# 不设时回退找 %USERPROFILE%\.xiao6-keys
X6_KEY_VAULT=E:\xiao6-keys

# 更新签名私钥文件路径。不设时用 %X6_KEY_VAULT%\RSA私钥-更新签名.pem
# 仅 build_release.py / sign_release.py / tools\sign_modules.py 会读它。
X6_SIGN_KEY=

# HMAC 激活码共享密钥文件路径。不设时用 %X6_KEY_VAULT%\密钥.key
# 留空 = 该机器不带 HMAC 密钥，只接受 RSA 激活码（这正是发布给客户的状态）。
X6_LICENSE_KEY=


# ---------- 端口 ----------
# 内置模块服务器端口（默认 8899）
MODULE_SERVER_PORT=8899


# ---------- 语音识别模型下载 ----------
# 首次用语音功能会从 HuggingFace 下载模型（tiny 约 75MB）。
# 国内直连不通时打开下面这行走镜像；模型缓存在 %USERPROFILE%\.cache\huggingface\hub\
# HF_ENDPOINT=https://hf-mirror.com

# 取消下面这行的注释可关掉 Windows 符号链接告警（不影响功能）
# HF_HUB_DISABLE_SYMLINKS_WARNING=1


# ---------- 建议顺手设上（避免中文乱码）----------
PYTHONIOENCODING=utf-8
