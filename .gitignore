# ============================================================
#  小6智能体 .gitignore
#
#  两条线：
#    1) 密钥 / 凭据 / 用户数据 —— 绝不入库，也绝不进发布包
#    2) 体积大的第三方库与产物 —— 不入库（靠 requirements.txt 还原 / 打包时另发）
#
#  实测：本文件生效后，git 只会纳入约 250 个自研 .py + 文档，约 1.2 MB；
#        若不忽略 libs/ 与 data/，会一次性提交 17500+ 个文件、800+ MB。
# ============================================================

# ---------- 一、密钥 / 凭据（绝不提交、绝不打包）----------
密钥.key
私钥.pem
RSA私钥*
*私钥*.pem
*私钥*.txt
*密钥汇总*.txt
小6智能体-全部密钥汇总.txt
.env

# 例外：程序端只用公钥，公钥可以公开（私钥在 E:\xiao6-keys，不在这里）
!core/公钥.pem
!core/激活公钥.pem
!.env.example

# ---------- 二、运行时数据（含 API Key / 授权码 / 聊天记录 / 用户资料）----------
# 整个 data/ 都是本机运行产生的，不入库。
# 配置模板另放在根目录的 config.default.json（已脱敏），那个要入库。
data/
*.db
*.sqlite
*.sqlite3

# ---------- 三、体积大的第三方库（785 MB，不入库）----------
# 靠 requirements.txt / requirements-optional.txt 还原；
# 发布包由 PyInstaller 或整体拷贝目录产出，不走 git。
libs/
optional_libs/

# ---------- 三之二、独立子仓库 ----------
# modules_repo 是一个独立的 git 仓库（远程 = gitee.com/cloud-drift/liuyun），
# 它有自己的 .git 与提交历史，由它自己版本控制；
# 在外层仓库里显式忽略，避免被记成一个含义不明的 gitlink。
modules_repo/

# ---------- 四、构建产物 / 备份 / 临时目录 ----------
/manifest.json
backups/
updates/
staging/
dist/
build/
*.spec.bak
# playwright 下载的浏览器（约 705 MB，本机产物）。
# 其实上面 `data/` 那条已经覆盖了它，这里单独列出来是为了写明意图：
# 放到程序文件夹是为了打包时自带浏览器，绝不进版本库。
data/browsers/
# 程序自己改代码时留下的备份（patch_utils / 自动更新 / 性能优化轮）
# 形如 xxx.py.bak_perf / xxx.py.bak_ui / xxx.py.bak_appfix，都是本机产物，不入库
*.bak_*
# 手写的 .bak 也别入库
*.bak
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- 五、编辑器 / 虚拟环境 ----------
.venv/
venv/
env/
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
